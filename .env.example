# 빌드 환경변수 예시 — 이 파일을 `.env.local` 로 복사해 값을 채웁니다.
# (`.env.local` 은 저장소에 올리지 않습니다.)
#
# 값이 비어 있으면 앱은 미리보기 모드로 동작합니다(결제창 없이 화면 흐름만 확인).
# 실제 결제를 켜려면 VITE_PAYAPP_WORKER_URL 만 채우면 됩니다.

# 1) 결제 확인 Worker 주소 (Cloudflare Workers 배포 후 발급)
#    예) https://byulgyeol-payapp.<계정>.workers.dev
VITE_PAYAPP_WORKER_URL=

# 2) 2027 수호 원석 굿즈 장바구니·알림 노출 여부 (기본 true)
#    1차 결제 심사용 빌드에서만 false 로 둡니다.
VITE_ENABLE_GOODS_CHECKOUT=true

# 2-1) 자미두수 단독 오픈 빌드 (기본 false)
#      true 로 빌드하면 서양 점성술 탭·상품·결제 동선이 화면에서 숨겨됩니다.
#      코드와 데이터는 그대로 남아 있어 값을 지우고 다시 빌드하면 복원됩니다.
VITE_ZIWEI_ONLY=false

# 3) 배포 경로 — 비우면 '/byulgyeol/' (GitHub Pages)
#    Cloudflare Pages 빌드에서는 '/' 로 지정합니다. (npm run build:pages 가 처리)
VITE_BASE_PATH=

# 4) 사업자 정보 — 비우면 src/config/legal.ts 의 기본값을 씁니다.
VITE_BIZ_COMPANY=모브릭
VITE_BIZ_REG_NO=409-37-46363
VITE_BIZ_CEO=박진영
VITE_BIZ_EMAIL=ggungzzang80@naver.com
VITE_BIZ_PHONE=010-9573-5868
VITE_BIZ_ADDRESS=인천광역시 검단구 고산후로95번길 24, 4층 401호 -X245호(당하동, 그린프라자)
VITE_BIZ_PRIVACY_OFFICER=박진영
VITE_BIZ_HOSTING=Cloudflare, Inc.
VITE_BIZ_EFFECTIVE_DATE=2026-11-18

# 5) 통신판매업 신고번호 — 발급 후 반드시 채웁니다. (비우면 '확인 후 기입(환경변수 …)' 표기)
VITE_BIZ_TELECOM_NO=
